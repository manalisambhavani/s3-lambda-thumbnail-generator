{
  "LambdaFunctionConfigurations": [
    {
      "Id": "GenerateThumbnailOnUpload",
      "LambdaFunctionArn": "arn:aws:lambda:us-east-1:000000000000:function:thumbnail-generator",
      "Events": [
        "s3:ObjectCreated:*"
      ],
      "Filter": {
        "Key": {
          "FilterRules": [
            {
              "Name": "suffix",
              "Value": ".jpg"
            }
          ]
        }
      }
    }
  ]
}