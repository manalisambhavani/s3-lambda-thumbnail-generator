{
  "LambdaFunctionConfigurations": [
    {
      "Id": "GenerateThumbnailOnUpload",
      "LambdaFunctionArn": "REPLACE_WITH_LAMBDA_ARN",
      "Events": [
        "s3:ObjectCreated:*"
      ],
      "Filter": {
        "Key": {
          "FilterRules": [
            {
              "Name": "suffix",
              "Value": ".jpg"
            }
          ]
        }
      }
    }
  ]
}